#!/usr/bin/env python3
"""
declarative-ddns: declarative DNS records for Spaceship.com with dynamic public-IP support.

Clone the repo anywhere and run it. On first run it creates everything it needs:

    config   ~/.config/declarative-ddns/config.toml    your records, grouped by domain (safe to commit)
    secrets  ~/.config/declarative-ddns/secrets.env    API key + secret (git-ignored, chmod 600)
    units    ~/.config/systemd/user/declarative-ddns.{service,timer}
    command  ~/.local/bin/declarative-ddns             symlink to this file

(All locations follow $XDG_CONFIG_HOME etc. when set. The install location is detected at
runtime, so moving the clone just means running it once from the new place.)

Config rules:
  * address = "auto" on an A/AAAA record follows your current public IP.
  * "{domain}" in any string expands to the domain the record belongs to.
  * Any record type/field the Spaceship API accepts works as-is (A, AAAA, CAA, CNAME, MX, SRV, TXT...).
  * For every (type, name) pair in the config, the config is the source of truth: other records
    with the same type+name are removed. Pairs the config never mentions are never touched.

Usage:
    declarative-ddns                    dry run: show what would change
    declarative-ddns sync --apply       make the changes (the timer runs exactly this)
    declarative-ddns list DOMAIN        raw JSON of the live records
    declarative-ddns export DOMAIN      live records as a config.toml snippet (good for bootstrapping)
    declarative-ddns enable | disable   turn the background timer on / off

Requires Python 3.11+ and nothing else.
"""
from __future__ import annotations

import sys

if sys.version_info < (3, 11):
    sys.exit("declarative-ddns requires Python 3.11 or newer")

import argparse
import getpass
import ipaddress
import json
